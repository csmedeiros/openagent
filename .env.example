# ─────────────────────────────────────────────────────────────────────────────
# OpenAgent — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Providers ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Workspace ─────────────────────────────────────────────────────────────────
# Diretório raiz onde o agente lê/escreve arquivos.
# No Docker: use o caminho DENTRO do container (C:\openagent-workspace).
# No Windows local: use seu caminho habitual.
WORKSPACE_ROOT=C:\Users\SeuUsuario\Documents\openagent-tests

# Diretório onde uploads da API são salvos (padrão: WORKSPACE_ROOT\uploads).
# UPLOAD_DIR=C:\Users\SeuUsuario\Documents\openagent-tests\uploads

# ── Portas ────────────────────────────────────────────────────────────────────
API_PORT=8080
WEB_PORT=3000

# ── Observabilidade ───────────────────────────────────────────────────────────
# MLFLOW_TRACKING_URI=http://127.0.0.1:1234
# LANGFUSE_PUBLIC_KEY=...
# LANGFUSE_SECRET_KEY=...
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── Docker: pasta do host montada como workspace ──────────────────────────────
# (usado no docker-compose.yml)
HOST_WORKSPACE=C:\openagent-workspace
